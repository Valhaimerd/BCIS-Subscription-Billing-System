# Copy this file to .env and replace every placeholder before running database commands.
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3100
LOG_LEVEL=info
DATABASE_URL=postgresql://bcis_app:replace-with-a-strong-password@127.0.0.1:5432/bcis
BCIS_API_BASE_URL=http://127.0.0.1:3100/api/v1
ATTACHMENT_DIRECTORY=./storage/attachments
BACKUP_DIRECTORY=./storage/backups
POSTGRES_BIN_DIRECTORY=C:\Program Files\PostgreSQL\18\bin
LOG_DIRECTORY=./storage/logs
LOG_MAX_BYTES=5242880
LOG_RETAINED_FILES=5

# Authentication defaults are safe for local development. Set the seed values
# before running `npm run db:seed`; never reuse this password outside the lab.
AUTH_SESSION_TTL_MINUTES=480
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
SEED_OWNER_USERNAME=owner
SEED_OWNER_EMAIL=owner@example.test
SEED_OWNER_PASSWORD=replace-with-a-unique-lab-password
